# Browser-visible values only. Never place service-role, Gemini, FCM server,
# database, or other private credentials in VITE_ variables.
VITE_APP_NAME=APP_NAME
VITE_DATA_MODE=mock
VITE_SUPABASE_URL=https://example-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-a-publishable-development-key
VITE_MAP_STYLE_URL=https://example.invalid/map-style.json

# Optional public Firebase web configuration for P1 push support.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_PUBLIC_KEY=
