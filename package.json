{
  "name": "urban-echo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.22.2 <23",
    "npm": ">=10 <13"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "contracts:sync": "node scripts/sync-contracts.mjs",
    "contracts:check": "node scripts/check-contracts.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:secrets": "node scripts/check-secrets.mjs",
    "supabase": "supabase"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.9",
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/supabase-js": "2.119.2",
    "@tanstack/react-query": "5.108.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dexie": "4.4.7",
    "i18next": "27.2.9",
    "lucide-react": "1.80.0",
    "maplibre-gl": "6.19.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-i18next": "18.0.3",
    "react-router-dom": "7.18.7",
    "recharts": "3.11.1",
    "tailwind-merge": "3.7.1",
    "workbox-window": "7.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "22.20.7",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "3.4.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.2"
  }
}
